# Where spans would go. Nothing is composed to receive them here, so export is
# off and nothing is issued; the three slots the store's and the gateway's
# `tracing` bindings are rendered from are named all the same, because the
# render reads them whether or not export is on. With export on, the store
# issues each export's Work Context through trace-binding, in the organisation
# of the spans it carries.
trace-audience=tracing
trace-resource-kind=tracing.spans
trace-binding=tracing
