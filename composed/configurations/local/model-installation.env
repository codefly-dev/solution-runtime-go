# The installation the composed gateway serves: an embedding profile and a chat
# profile on Vertex through the developer's own gcloud application-default
# credentials. Listing the installed profiles calls no provider; embedding
# through one needs `gcloud auth application-default login` and a project that
# serves the model. The project and its service account below are the gateway's
# own playground placeholder (local-playground), no real project or account:
# set yours on your machine with
#   codefly config set model-installation vertex-project=<project> vertex-service-account=<account> --plaintext --force
# and do not commit the result (Codefly has no machine-local layer for a plain
# configuration value yet). The store embeds through this gateway only when its
# `embeddings` group selects the installed provider (embeddings.env).
audience=model
vertex-project=local-playground
vertex-location=us-east1
vertex-service-account=local-playground@local-playground.iam.gserviceaccount.com
vertex-bearer-source=developer-adc
embedding-model=gemini-embedding-001
embedding-dimensions=768
chat-model=google/gemini-2.5-flash-lite
max-output-tokens=4096
max-input-bytes=65536
